# Copy this file to .env and fill in the values from the class sandbox.
# .env is git-ignored -- never commit real keys.

# --- LLM (class proxy, OpenAI-compatible) ---
OPENAI_API_KEY=your-key-here
OPENAI_BASE_URL=https://your-class-proxy/v1
LLM_MODEL=gemma-4-E4B-it

# --- Embeddings (local, multilingual so Thai queries can match English plots) ---
# used by scripts/build_index.py; the app reads the model from the index's meta.json
EMBED_MODEL=intfloat/multilingual-e5-small

# --- Retrieval defaults (tuned by eval/run_eval.py; see README) ---
CHUNK_WORDS=200
CHUNK_OVERLAP=50
TOP_K=5
# 0.78: highest floor that keeps hybrid+rewrite recall@5 at 75%; 0.82 halved it to 37.5% (eval section 2)
MIN_SCORE=0.78
# dense | bm25 | hybrid  (hybrid won the first eval run)
RETRIEVAL_MODE=hybrid
# optional cross-encoder that reorders the top-30 (empty = off), e.g.
# cross-encoder/ms-marco-MiniLM-L-6-v2 -- see eval/results/report.md "+rerank" rows
RERANK_MODEL=

# --- Agent ---
AGENT_MAX_STEPS=5
