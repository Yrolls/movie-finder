# Copy this file to .env and fill in the values from the class sandbox.
# .env is git-ignored -- never commit real keys.

# --- LLM (class proxy, OpenAI-compatible) ---
OPENAI_API_KEY=your-key-here
OPENAI_BASE_URL=https://your-class-proxy/v1
LLM_MODEL=gemma-4-E4B-it

# --- Embeddings (local; the agent rewrites queries to English first, so an English model is used) ---
# bge+rerank: recall@5 81.0% vs 78.6% for the best e5 row on the main set (inside the CI; report.md section 1)
# used by scripts/build_index.py; the app reads the model from the index's meta.json
EMBED_MODEL=BAAI/bge-small-en-v1.5

# --- Retrieval defaults (tuned by eval/run_eval.py; see README) ---
CHUNK_WORDS=200
CHUNK_OVERLAP=50
TOP_K=5
# bge similarities sit lower than e5: 0.50 keeps hybrid+rewrite recall@5; 0.60+ starts dropping it (eval section 2)
MIN_SCORE=0.50
# dense | bm25 | hybrid  (hybrid won the first eval run)
RETRIEVAL_MODE=hybrid
# cross-encoder that reorders the top-30 (empty = off)
# hybrid+rewrite+rerank was the best retrieval row -- see eval/results/report.md
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Agent ---
AGENT_MAX_STEPS=5
