# Copy this file to .env and fill in the two values from the class sandbox.
#   Windows:      copy .env.example .env
#   macOS/Linux:  cp .env.example .env
# .env is git-ignored -- never commit real keys. Everything below the LLM block is optional:
# these are the tuned defaults (see eval/results/report.md), and the code uses the same values
# when a line is missing.

# --- LLM (class proxy, OpenAI-compatible) -- REQUIRED ---
OPENAI_API_KEY=your-key-here
OPENAI_BASE_URL=https://your-class-proxy/v1
LLM_MODEL=gemma-4-E4B-it

# --- Embeddings (local, multilingual so Thai queries can match English plots) ---
# Used by scripts/build_index.py. The app always embeds queries with the model saved in the
# index's meta.json, so change this only together with a rebuild of the index.
# Tried: BAAI/bge-small-en-v1.5 (+rerank) -- better retrieval rows, but the agent fell 85.7% -> 83.3%.
EMBED_MODEL=intfloat/multilingual-e5-small

# --- Retrieval ---
CHUNK_WORDS=200
CHUNK_OVERLAP=50
# results per plot search
TOP_K=5
# floor on the dense similarity of a hit; 0.78 removes no correct film on the main set,
# 0.82 halved recall (eval section 2)
MIN_SCORE=0.78
# dense | bm25 | hybrid   (hybrid = BM25 + dense fused with RRF; it won the eval)
RETRIEVAL_MODE=hybrid
# optional cross-encoder that reorders the top-30 (empty = off). Tried
# cross-encoder/ms-marco-MiniLM-L-6-v2: same recall@5, slightly better MRR, slower -> off.
RERANK_MODEL=

# --- Agent ---
# maximum tool-calling turns per question (answer repairs do not count)
AGENT_MAX_STEPS=5
